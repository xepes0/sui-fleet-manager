# Copy to .env. Keep this file private.
FLEET_USER=admin
FLEET_PASSWORD=replace-with-a-long-random-password
# Base64 of exactly 32 random bytes. Generate with: openssl rand -base64 32
FLEET_MASTER_KEY=replace-with-base64-key
# URL of the existing modified Komari panel; omit the trailing slash.
KOMARI_URL=https://komari.example.com
# Browser-facing URL for opening a Komari node. Must be reachable from phones.
# Keep this separate when KOMARI_URL is an internal or loopback address.
KOMARI_PUBLIC_URL=https://komari.example.com
# Optional; needed to include hidden Komari nodes or a private Komari site.
KOMARI_API_KEY=
# For direct public access, set a public listen address and both TLS files.
# Never bind a public HTTP listener; the app rejects that configuration.
# FLEET_LISTEN=0.0.0.0:18780
# FLEET_TLS_CERT=/etc/sui-fleet-manager/tls/cert.crt
# FLEET_TLS_KEY=/etc/sui-fleet-manager/tls/private.key
